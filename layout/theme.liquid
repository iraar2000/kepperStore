<style>
  {% comment %} color variables {% endcomment %}
  :root {
    --primary-color: {{ settings.primary_color }};
    --background-color: {{ settings.background_color }};
    --secondary-color: {{ settings.secondary_color }};
    --accent-color: {{ settings.accent_color }};
    --gray-color: {{ settings.gray_color }};
    --darkgray-color: {{ settings.darkgray_color }};
  }
  {% comment %} font size and weight variables {% endcomment %}
  :root {
    --font-size-small: 12px;
    --font-size-medium: 13px;
    --font-size-large: 16px;
    --font-size-xlarge: 18px;
    --font-weight-regular: 400;
    --font-weight-medium: 500;
    --font-weight-bold: 700;
  }
</style>

<html>
  <head>
    {% comment %} including global styles and scripts  {% endcomment %}
    {{ content_for_header }}
    <!-- Add this to your HTML head if needed -->
    {{ 'main.css' | asset_url | stylesheet_tag }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    >
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    >
  </head>
  <body>
    {{ content_for_layout }}
    {% comment %} menu script inclusion {% endcomment %}
    <script>
      {% comment %} icon variable {% endcomment %}
      const icons = {
        cameras: "{{ 'camera-icon.svg' | asset_url }}",
        'shoes & clothes': "{{ 'shoesclothes-icon.svg' | asset_url }}",
        'laptop & pc': "{{ 'pc-icon.svg' | asset_url }}",
        'phones & tablets': "{{ 'tablet-icon.svg' | asset_url }}",
        rentals: "{{ 'rental-icon.svg' | asset_url }}",
      };

      {% comment %} account variable {% endcomment %}
      const accounts = {
        whatsapp: '{{ settings.whatsapp_account }}',
        youtube: '{{ settings.youtube_account }}',
        facebook: '{{ settings.facebook_account }}',
        instagram: '{{ settings.instagram_account }}',
      };
    </script>
    <script type="module" src="{{ 'main.js' | asset_url }}"></script>
  </body>
</html>
