<style>
  {% comment %} color variables {% endcomment %}
  :root {
    --primary-color: {{ settings.primary_color }};
    --background-color: {{ settings.background_color }};
    --secondary-color: {{ settings.secondary_color }};
    --accent-color: {{ settings.accent_color }};
    --gray-color: {{ settings.gray_color }};
    --darkgray-color: {{ settings.darkgray_color }};
  }
  {% comment %} font size and weight variables {% endcomment %}
  :root {
    --font-size-small: 12px;
    --font-size-medium: 13px;
    --font-size-large: 16px;
    --font-size-xlarge: 18px;
    --font-weight-regular: 400;
    --font-weight-medium: 500;
    --font-weight-bold: 700;
  }
</style>

<html>
  <head>
    {% comment %} including global styles and scripts  {% endcomment %}
    {{ content_for_header }}
    <!-- Add this to your HTML head if needed -->
    {{ 'css-main.css' | asset_url | stylesheet_tag }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    >
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    >
  </head>
  <body>
    {{ content_for_layout }}

    {% comment %} category item template {% endcomment %}
    {% render 'subcateg-item' %}

    {% comment %} display container template {% endcomment %}
    {% render 'display-container' %}

    {% comment %} group container template {% endcomment %}
    {% render 'group-container' %}

    {% comment %} product item template {% endcomment %}

    <script>
      {% comment %} icon variable {% endcomment %}
      const icons = {
        camera: "{{ 'image-camera-icon.svg' | asset_url }}",
        'shoes-clothes': "{{ 'image-shoesclothes-icon.svg' | asset_url }}",
        'laptop-pc': "{{ 'image-pc-icon.svg' | asset_url }}",
        'phones-tables': "{{ 'image-tablet-icon.svg' | asset_url }}",
        rentals: "{{ 'image-rental-icon.svg' | asset_url }}",
      };

      {% comment %} images to use variable is defined {% endcomment %}
      const useImage = {
        "add-image": "{{ 'image-addPicture.png' | asset_url }}"
      }

      {% comment %} account variable {% endcomment %}
      const accounts = {
        whatsapp: '{{ settings.whatsapp_account }}',
        youtube: '{{ settings.youtube_account }}',
        facebook: '{{ settings.facebook_account }}',
        instagram: '{{ settings.instagram_account }}',
      };

      {% comment %} the function retrieves the collections stored in shopify and their data {% endcomment %}
      function getCollectionsJson() {

        const collectionsData = [
          {% for coll in collections %}
            {
              id: {{ coll.id }},
              title: "{{ coll.title | escape }}",
              handle: "{{ coll.handle | escape }}",
              type: "{{ coll.metafields.custom.collection_type | escape }}",
              products_count: {{ coll.products_count }},
              image: {
                  id: {{ coll.image.id }},
                  asp: {{ coll.image.aspect_ratio }},
                  src: "{{ coll.image | image_url: width: 300}}"
              },
              parent: {% if coll.metafields.custom.parent.value %}
                {
                  id: {{ coll.metafields.custom.parent.value.id }},
                  title: "{{ coll.metafields.custom.parent.value.title }}",
                  handle: "{{ coll.metafields.custom.parent.value.handle }}"
                }
              {% else %}
                null
              {% endif %},
              subcategories: {% if coll.metafields.custom.sub_collections.value %}
                [
                {% for sub_coll in coll.metafields.custom.sub_collections.value %}
                  {
                    id: {{ sub_coll.id }},
                    title: "{{ sub_coll.title }}",
                    handle: "{{ sub_coll.handle }}"
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
                ]
              {% else %}
                []
              {% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];
        return collectionsData;
      }
    </script>
    {{ 'script-definitions.js' | asset_url | script_tag }}
    <script type="module" src="{{ 'script-main.js' | asset_url }}"></script>
    {{ 'script-restapi.js' | asset_url | script_tag }}
  </body>
</html>
