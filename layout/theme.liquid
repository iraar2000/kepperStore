<style>
  {% comment %} color variables {% endcomment %}
  :root {
    --primary-color: {{ settings.primary_color }};
    --background-color: {{ settings.background_color }};
    --secondary-color: {{ settings.secondary_color }};
    --accent-color: {{ settings.accent_color }};
    --gray-color: {{ settings.gray_color }};
    --darkgray-color: {{ settings.darkgray_color }};
    --danger-color: {{ settings.danger_color }}
  }
  {% comment %} font size and weight variables {% endcomment %}
  :root {
    --font-size-small: 12px;
    --font-size-medium: 13px;
    --font-size-large: 16px;
    --font-size-xlarge: 20px;
    --font-weight-regular: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
  }
</style>

<html>
  <head>
    {% comment %} including global styles and scripts  {% endcomment %}
    {{ content_for_header }}
    <!-- Add this to your HTML head if needed -->
    {{ 'css-main.css' | asset_url | stylesheet_tag }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    >
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    >
  </head>
  <body>
    {{ content_for_layout }}

    {% comment %} category item template {% endcomment %}
    {% render 'subcateg-item' %}

    {% comment %} display container template {% endcomment %}
    {% render 'display-container' %}

    {% comment %} group container template {% endcomment %}
    {% render 'group-container' %}

    {% comment %} product item template {% endcomment %}
    {% render 'product-card' %}

    {% comment %} navigation menu template {% endcomment %}
    {% render 'navigation-container' %}
    <script>
      {% comment %} icon variable {% endcomment %}
      const icons = {
        cameras: "{{ 'icon-camera.svg' | asset_url }}",
        'clothes-shoes': "{{ 'icon-shoesclothes.svg' | asset_url }}",
        'laptops-pc': "{{ 'icon-pc.svg' | asset_url }}",
        'phones-tablets': "{{ 'icon-tablet.svg' | asset_url }}",
        accessories: "{{ 'icon-accessories.svg' | asset_url }}",
        rentals: "{{ 'icon-rental.svg' | asset_url }}",
        instock: "{{ 'icon-instock.svg' | asset_url}}",
        contact: "{{ 'icon-contact.svg' | asset_url }}",
        youtube: "{{ 'icon-youtube.svg' | asset_url }}",
        whatsapp: "{{ 'icon-whatsapp.svg' | asset_url }}",
        facebook: "{{ 'icon-facebook.svg' | asset_url }}",
        email: "{{ 'icon-email.svg' | asset_url }}",
        instagram: "{{ 'icon-instagram.svg' | asset_url }}",
        upArrow: "{{ 'icon-up.svg' | asset_url }}",
        user: "{{ 'icon-user.svg' | asset_url }}",
        shipping: "{{ 'icon-shipping.svg' | asset_url }}",
        location: "{{ 'icon-location.svg' | asset_url }}",
        cart: "{{ 'icon-cart.svg' | asset_url }}"
      };

      {% comment %} images to use variable is defined {% endcomment %}
      const useImage = {
        "add-image": "{{ 'image-addPicture.png' | asset_url }}"
      }

      {% comment %} account variable {% endcomment %}
      const accounts = {
        whatsapp: '{{ settings.whatsapp_account }}',
        youtube: '{{ settings.youtube_account }}',
        facebook: '{{ settings.facebook_account }}',
        instagram: '{{ settings.instagram_account }}',
      };

      {% comment %} retrieving all collections in shopify {% endcomment %}
      const collectionList = [
        {% for coll in collections %}
          {
            title: {{ coll.title | json}},
            handle: {{ coll.handle | json }},
            type: {{ coll.metafields.custom.type | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
    {{ 'script-definitions.js' | asset_url | script_tag }}
    <script type="module" src="{{ 'script-main.js' | asset_url }}"></script>
  </body>
</html>
