<div class="bottom-menu-container">
  <div class="container">
    <div class="searchBox">
      {% assign categories = 'All categories,iPhone,Samsung,Xiamo' | split: ',' %}
      {% render 'dropdown', title: 'categories', size: 'md', items: categories %}
      <div class="searchInput">
        <input placeholder="search anything...">
        <span class="icon-container search-icon">
          {% render 'search-icon' %}
        </span>
      </div>
    </div>
    <div class="spacer"></div>
    <div class="offer-navigator"></div>
  </div>
</div>
