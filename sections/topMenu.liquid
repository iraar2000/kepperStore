<div class="top-menu-container">
  <div class="container">
    {% comment %} Support contact information {% endcomment %}
    <div class="menu-support-contact-container">
      <div class="btn btn-secondary btn-sm">Hotline 24/7</div>
      <p style="font-weight: var(--font-weight-bold);">{{ settings.hotline_nbr }}</p>
    </div>
    <div class="spacer"></div>
    {% comment %} Settings information {% endcomment %}
    <div class="menu-settings-container">
      <div class="btn btn-secondary btn-sm">Sell on Kepper</div>
      {% comment %} currency drop down {% endcomment %}
      {% assign currency_items = localization.available_countries | map: 'currency' %}
      {% assign currency_items = currency_items | map: 'iso_code' | uniq %}
      {% render 'dropdown',
        title: 'currency',
        size: 'sm',
        form_type: 'localization',
        name_code: 'currency_code',
        items: currency_items
      %}

      {% comment %} langauge dropdown box {% endcomment %}
      {% assign laguage_items = localization.available_languages | map: 'iso_code' %}
      {% render 'dropdown',
        title: 'language',
        size: 'sm',
        form_type: 'localization',
        name_code: 'language_code',
        items: laguage_items
      %}
    </div>
  </div>
</div>
