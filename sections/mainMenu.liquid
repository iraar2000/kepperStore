{% schema %}
{
  "name": "main menu",
  "settings": [
    {
      "type": "text",
      "id": "menu_list",
      "label": "list_menu",
      "default": "home,products,contact"
    }
  ]
}
{% endschema %}

<div class="main-menu-container">
  <div class="container">
    {% comment %} menu navigator container box {% endcomment %}
    <div class="navigator">
      <div class="logo">
        <div class="image"></div>
        <div class="name">
          <p>{{ settings.store_name }}</p>
          <p>TECH STORE</p>
        </div>
      </div>
      <div class="menu-navigator-container">
        <nav class="menu-navigator">
          <ul class="menu-list">
            {% assign menu_list = section.settings.menu_list | split: ',' %}
            {% for menu in menu_list %}
              <li
                class="
                  menu-item-container
                  {% if  request.path == "/" and menu == 'home' %} active
                  {% elsif request.path contains menu %} active
                  {% endif %}
                "
              >
                <a
                  href="
                    {% if menu == "home" %} /
                    {% elsif menu == "products" %} /pages/products
                    {% elsif menu == "contact" %} /pages/contact
                    {% else %} /
                    {% endif %}
                  "
                >
                  <div class="menu-item">{{ menu | upcase }}</div>
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      </div>
    </div>
    <div class="spacer"></div>

    {% comment %} pages navigator section {% endcomment %}
    <div class="page-navs">
      {% comment %} favorite button {% endcomment %}
      {% capture favorite_icon %}{% render 'favorite-icon'%}{% endcapture %}
      {% render 'wishlistCard', path: '/pages/favorites', icon: favorite_icon %}

      {% comment %} account page setting {% endcomment %}
      {% capture user_icon %}{% render 'user-icon'%}{% endcapture %}
      {% render 'wishlistCard',
        path: '/pages/accounts',
        icon: user_icon,
        description_ttl: 'WELCOME',
        description: 'LOGIN/REGISTER'
      %}

      {% comment %} cart navigatior {% endcomment %}
      {% capture cart_icon %}{% render 'cart-icon'%}{% endcapture %}
      {% render 'wishlistCard',
        path: '/pages/cart',
        icon: cart_icon,
        description_ttl: 'CART',
        description: 'RW100,00',
        popup_info: '5'
      %}
    </div>
  </div>
</div>
