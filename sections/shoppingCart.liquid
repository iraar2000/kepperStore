<div class="shoppingCart-container">
  <!-- shopping cart container -->
  <div class="shopping-cart">
    <div class="cart-container">
      <div class="cartTitle-container">
        <p class="cart-title">STORE CART</p>
        <p class="product-count"></p>
      </div>
      <div class="cartContent-container">
        <div class="cart-header"></div>
        <div class="cart-body"></div>
      </div>
    </div>
    <div class="cart-value">
      <div class="cartValue-container">
        <p class="cart-title cartValue-title">CART VALUE</p>
        <div class="valueChange-container">
          <div class="valueData-container real-value">
            <p class="value-title">products, 0 pieces</p>
            <p class="value-price">0.0 RF</p>
          </div>
          <div class="valueData-container change-value">
            <p class="value-title">total change</p>
            <p class="value-price">0.0 RF</p>
          </div>
        </div>
        <div class="valueData-container total-value">
          <p class="total-title">TOTAL VALUE</p>
          <p class="total-price">0.0 RF</p>
        </div>
        <div class="checkout-btn"><p class="checkout-txt">CHECKOUT</p></div>
      </div>
    </div>
  </div>

  <!-- sharing section container -->
  <div class="sharing-container">
    <!-- window closing -->
    <div class="top-controller">
      <div class="close-button">
        <i class="fa-solid fa-x"></i>
      </div>
    </div>

    <!-- the component container -->
    <div class="sharingComponents-container">
      <div class="title-container">
        <p class="title">SHARE WITH</p>
        <p class="subtitle">select the mode of sharing you want to use, you can only select one social media.</p>
      </div>
      <div class="component-container">
