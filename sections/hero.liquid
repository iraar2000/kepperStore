<div class="body-container">
  <div class="hero-section">
    {% comment %} collection title {% endcomment %}
    <div class="collectionList-container">
      <div class="title">
        <p>Collection</p>
      </div>

      {% comment %} collection items section {% endcomment %}
      <div class="collection-content"></div>
    </div>
    <div class="banner-container">
      <img class="banner-image" alt="image" src="{{ "image-banner-image.jpg" | asset_url }}">
      <div class="banner-content">
        <p class="description">Welcome to Kepper store</p>
        <p class="sub-description">We hope you enjoy shoping to our site.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    }
  ]
}
{% endschema %}
